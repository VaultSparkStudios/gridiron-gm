{
  "name": "gridiron-gm",
  "version": "1.0.0",
  "description": "Gridiron GM is a realistic football general manager simulation game based off the National Football League (NFL).",
  "homepage": "https://evandamours.github.io/27_Gridiron_GM/",
  "repository": {
    "type": "git",
    "url": "https://github.com/EvanDAmours/27_Gridiron_GM.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build && node scripts/postbuild-pages.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "build:mobile": "VITE_MOBILE=1 vite build --outDir dist-mobile --emptyOutDir",
    "build:pages:all": "VITE_APP_BASE_PATH=/27_Gridiron_GM/ npm run build:pages && VITE_APP_BASE_PATH=/27_Gridiron_GM/mobile/ npm run build:mobile && rm -rf dist/mobile && cp -r dist-mobile dist/mobile",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm test && npm run build && npm run smoke",
    "publish:pages": "bash scripts/publish-pages.sh",
    "health": "node scripts/health.mjs",
    "scoring": "node scripts/scoring.mjs"
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "canvas": "^3.2.2",
    "playwright-core": "^1.55.0",
    "vite": "^7.3.1"
  }
}
